# Environment matrix
# | var                  | local                         | CI           | production (Vercel)     |
# |----------------------|-------------------------------|--------------|-------------------------|
# | ENVIRONMENT          | local                         | ci           | production              |
# | DATABASE_URL         | docker compose (below)        | CI service   | Neon pooled URL         |
# | DATABASE_URL_UNPOOLED| unset                         | unset        | Neon direct URL (seed)  |
# | *_PROVIDER           | fake or real                  | fake         | real                    |
# | *_API_KEY            | optional                      | unset        | required for real ones  |

ENVIRONMENT=local
DATABASE_URL=postgresql://emporio:emporio@localhost:5433/emporio
# Only for `python -m etl` against Neon; the seed prefers it over DATABASE_URL.
DATABASE_URL_UNPOOLED=

# fake | anthropic | openrouter
LLM_PROVIDER=fake
# fake | jev | haiku | openrouter (ids with "decider" use the decisions API)
ROUTER_PROVIDER=fake
# fake | gemini
EMBEDDINGS_PROVIDER=fake
EMBEDDINGS_MODEL=gemini-embedding-001

# Agent (specs/002-agent-core). Models: specialist handles routed single intents, general the rest.
SPECIALIST_MODEL=claude-haiku-4-5-20251001
GENERAL_MODEL=claude-sonnet-5-5
# With *_PROVIDER=openrouter, set these to OpenRouter ids (e.g. vendor/model). ROUTER_MODEL empty = SPECIALIST_MODEL.
ROUTER_MODEL=
# Below this router confidence the turn goes to the general path.
ROUTER_CONFIDENCE_THRESHOLD=0.75
# One budget for the primary router plus its fallback.
ROUTER_TIMEOUT_MS=2500
# Max model/tool steps per turn.
AGENT_MAX_STEPS=8
LLM_MAX_TOKENS=1024
# Per model request, in seconds.
LLM_TIMEOUT_S=30
# Whole turn, in seconds.
TURN_TIMEOUT_S=60
# Messages of history sent to the model.
HISTORY_MAX_MESSAGES=12
INPUT_MAX_CHARS=2000

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
GEMINI_API_KEY=

# specs/004-auth-limits-deploy. Shared with the frontend's SERVICE_JWT_SECRET (same value, not a
# key pair); verifies the short-lived JWT the Next.js BFF attaches to /api/chat. Required in
# production: the app refuses to start (and refuses every chat request) without it.
SERVICE_JWT_SECRET=
RATE_LIMIT_PER_MINUTE=20
DAILY_TOKEN_BUDGET=200000
BUDGET_TIMEZONE=America/Campo_Grande
