# Environment matrix
# | var                  | local                         | CI           | production (Vercel)     |
# |----------------------|-------------------------------|--------------|-------------------------|
# | ENVIRONMENT          | local                         | ci           | production              |
# | DATABASE_URL         | docker compose (below)        | CI service   | Neon pooled URL         |
# | DATABASE_URL_UNPOOLED| unset                         | unset        | Neon direct URL (seed)  |
# | *_PROVIDER           | fake or real                  | fake         | real                    |
# | *_API_KEY            | optional                      | unset        | required for real ones  |

ENVIRONMENT=local
DATABASE_URL=postgresql://emporio:emporio@localhost:5433/emporio
# Only for `python -m etl` against Neon; the seed prefers it over DATABASE_URL.
DATABASE_URL_UNPOOLED=

# fake | anthropic
LLM_PROVIDER=fake
# fake | jev | haiku
ROUTER_PROVIDER=fake
# fake | gemini
EMBEDDINGS_PROVIDER=fake
EMBEDDINGS_MODEL=gemini-embedding-001

ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
GEMINI_API_KEY=
