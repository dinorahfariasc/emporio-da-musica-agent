# Local development only; in production Vercel injects BACKEND_URL via the service binding.
BACKEND_URL=http://localhost:8000
# mock: replay contracts/chat-stream fixtures | backend: proxy to the FastAPI agent
CHAT_MODE=mock

# specs/004-auth-limits-deploy.
# Auth.js session/cookie signing secret; any random string locally (e.g. `openssl rand -base64 32`).
AUTH_SECRET=
# Shared with the backend's SERVICE_JWT_SECRET (same value, not a key pair); must match exactly.
SERVICE_JWT_SECRET=
# Same Postgres database the backend uses; the login path and scripts/create-user.ts read it
# directly (no ORM). Use the pooled URL here; scripts/create-user.ts wants DATABASE_URL_UNPOOLED.
DATABASE_URL=postgresql://emporio:emporio@localhost:5433/emporio
DATABASE_URL_UNPOOLED=
